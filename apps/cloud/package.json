{
  "name": "@fleet/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file seeds/dev.sql",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fleet/shared": "workspace:*",
    "@fleet/threemf": "workspace:*",
    "@tanstack/react-query": "5.104.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "ulidx": "2.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.3",
    "@cloudflare/workers-types": "5.20261015.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.151.0"
  }
}
